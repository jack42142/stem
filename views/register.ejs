<!DOCTYPE html>
<html>
<head>
    <title>Đăng Ký Tài Khoản</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center vh-100">
    <div class="container card p-4 shadow-sm" style="max-width: 400px;">
        <h4 class="text-center mb-4">Tạo Tài Khoản</h4>
        <% if (error) { %> <div class="alert alert-danger small"><%= error %></div> <% } %>
        <% if (success) { %> <div class="alert alert-success small"><%= success %></div> <% } %>
        <form method="POST">
            <input name="user" class="form-control mb-2" placeholder="Tên đăng nhập" required>
            <input name="pass" type="password" class="form-control mb-2" placeholder="Mật khẩu" required>
            <select name="role" class="form-select mb-3">
                <option value="STU">Học sinh (Student)</option>
                <option value="TEA">Giáo viên (Teacher)</option>
            </select>
            <button class="btn btn-success w-100 mb-2">Đăng ký</button>
            <div class="text-center">
                <a href="/login" class="text-decoration-none small">Quay lại đăng nhập</a>
            </div>
        </form>
    </div>
</body>
</html>
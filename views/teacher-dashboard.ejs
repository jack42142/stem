<!DOCTYPE html>
<html>
<head>
    <title>Quản lý Giáo viên</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .exam-item { cursor: pointer; transition: 0.2s; border: 1px solid #ddd; border-radius: 8px; }
        .exam-item:hover { background: #f8f9fa; }
        .active-exam { border: 2px solid #0d6efd !important; background: #e7f1ff !important; }
        .vlt-panel { display: none; }
        .delete-btn { color: #dc3545; padding: 5px 10px; border-radius: 5px; cursor: pointer; }
        .delete-btn:hover { background: #fee2e2; }
    </style>
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">TẠO BÀI THI MỚI</h6>
                        <form action="/publish-exam" method="POST">
                            <input name="examName" class="form-control mb-2" placeholder="Tên bài thi" required>
                            <input name="examLink" class="form-control mb-3" placeholder="Link Google Form" required>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" name="useAI" checked>
                                <label class="form-check-label">Giám sát AI (MediaPipe)</label>
                            </div>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" name="useAntiTab" checked>
                                <label class="form-check-label">Chống chuyển Tab</label>
                            </div>
                            <div class="form-check form-switch small mb-3">
                                <input class="form-check-input" type="checkbox" name="useAntiVM" checked>
                                <label class="form-check-label">Phát hiện Máy ảo (WebGL)</label>
                            </div>
                            <button class="btn btn-primary w-100">Phát hành</button>
                        </form>
                    </div>
                </div>

                <h6 class="text-muted fw-bold small">DANH SÁCH ĐÃ GIAO</h6>
                <div id="exam-list">
                    <% exams.forEach(exam => { %>
                        <div class="exam-item p-3 mb-2 bg-white d-flex justify-content-between align-items-center shadow-sm" 
                             onclick="selectExam('<%= exam.name %>', this)">
                            <div>
                                <div class="fw-bold text-truncate" style="max-width: 200px;"><%= exam.name %></div>
                                <small class="text-muted text-uppercase" style="font-size: 10px;">ID: <%= exam.id %></small>
                            </div>
                            <div class="delete-btn" onclick="deleteExam('<%= exam.id %>', event)">
                                <i class="bi bi-trash3-fill"></i>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="col-md-8">
                <div id="no-select" class="text-center py-5 bg-white rounded shadow-sm">
                    <i class="bi bi-clipboard2-check text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">Chọn một bài thi để kiểm tra lỗi vi phạm</p>
                </div>
                <div id="vlt-area" class="vlt-panel">
                    <div class="card shadow-sm border-0 text-dark">
                        <div class="card-header bg-danger text-white fw-bold d-flex justify-content-between">
                            <span id="vlt-title">Vi phạm</span>
                            <small id="vlt-time">Đang đợi...</small>
                        </div>
                        <div class="card-body p-0" style="max-height: 70vh; overflow-y: auto;">
                            <table class="table table-hover mb-0">
                                <thead class="table-light"><tr><th>Thí sinh</th><th>Lý do</th><th>Minh chứng</th></tr></thead>
                                <tbody id="vlt-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let selectedName = null;
        let timer = null;

        function selectExam(name, el) {
            document.querySelectorAll('.exam-item').forEach(i => i.classList.remove('active-exam'));
            el.classList.add('active-exam');
            document.getElementById('no-select').style.display = 'none';
            document.getElementById('vlt-area').style.display = 'block';
            document.getElementById('vlt-title').innerText = "Vi phạm: " + name;
            selectedName = name;
            loadVlts();
            if(timer) clearInterval(timer);
            timer = setInterval(loadVlts, 4000);
        }

        function loadVlts() {
            if(!selectedName) return;
            fetch('/get-violations').then(r => r.json()).then(data => {
                const filtered = data.filter(v => v.exam === selectedName);
                const body = document.getElementById('vlt-body');
                body.innerHTML = filtered.length ? filtered.reverse().map(v => `
                    <tr>
                        <td><b>${v.user}</b><br><small class="text-muted">${v.time}</small></td>
                        <td><span class="badge bg-danger">${v.reason}</span></td>
                        <td><a href="${v.imagePath}" target="_blank"><img src="${v.imagePath}" width="60" class="rounded border"></a></td>
                    </tr>
                `).join('') : '<tr><td colspan="3" class="text-center py-4 text-muted">Không tìm thấy vi phạm nào</td></tr>';
                document.getElementById('vlt-time').innerText = "Lúc: " + new Date().toLocaleTimeString();
            });
        }

        function deleteExam(id, event) {
            event.stopPropagation();
            if(!confirm("Bạn có chắc chắn muốn xóa bài thi này?")) return;
            fetch('/delete-exam', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ examId: id })
            }).then(() => location.reload());
        }
    </script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <title>Teacher - MediaPipe Guard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <div class="container py-4">
        <div class="d-flex justify-content-between mb-4">
            <h4>Giáo viên: <%= user.user %></h4>
            <a href="/logout" class="btn btn-outline-danger btn-sm">Thoát</a>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="card bg-secondary mb-3 shadow border-0">
                    <div class="card-header bg-primary fw-bold text-center">GIAO BÀI THI MỚI</div>
                    <div class="card-body">
                        <form action="/publish-exam" method="POST">
                            <input name="examName" class="form-control mb-2" placeholder="Tên bài thi" required>
                            <input name="examLink" class="form-control mb-3" placeholder="Link Google Form" required>
                            <p class="small mb-1 text-warning">Cài đặt bảo mật:</p>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" name="useAI" checked>
                                <label class="form-check-label">Bật AI MediaPipe (4s)</label>
                            </div>
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" name="useAntiTab" checked>
                                <label class="form-check-label">Chặn Chuyển Tab/Blur</label>
                            </div>
                            <div class="form-check form-switch small mb-3">
                                <input class="form-check-input" type="checkbox" name="useVM" checked>
                                <label class="form-check-label">Kiểm tra Máy ảo</label>
                            </div>
                            <button class="btn btn-success w-100 fw-bold shadow">KÍCH HOẠT</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card shadow text-dark border-0">
                    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                        <b>DỮ LIỆU VI PHẠM</b>
                        <select id="filter-exam" class="form-select form-select-sm w-auto" onchange="loadViolations()">
                            <option value="all">Tất cả bài thi</option>
                            <% exams.forEach(exam => { %>
                                <option value="<%= exam.name %>"><%= exam.name %></option>
                            <% }) %>
                        </select>
                        <small id="sync-status">Đang tải...</small>
                    </div>
                    <div class="card-body bg-light p-0" style="max-height: 550px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr><th>Học sinh</th><th>Vi phạm</th><th>Hình ảnh</th></tr>
                            </thead>
                            <tbody id="violation-list"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function loadViolations() {
            const filter = document.getElementById('filter-exam').value;
            fetch('/get-violations').then(res => res.json()).then(data => {
                const filteredData = filter === 'all' ? data : data.filter(v => v.exam === filter);
                document.getElementById('violation-list').innerHTML = filteredData.reverse().map(v => `
                    <tr>
                        <td><b>${v.user}</b><br><small class="text-muted">${v.exam}</small></td>
                        <td><span class="badge bg-danger">${v.reason}</span><br><small>${v.time}</small></td>
                        <td><a href="${v.imagePath}" target="_blank"><img src="${v.imagePath}" width="70" class="rounded border shadow-sm"></a></td>
                    </tr>
                `).join('');
                document.getElementById('sync-status').innerText = "Cập nhật: " + new Date().toLocaleTimeString();
            });
        }
        setInterval(loadViolations, 4000);
        loadViolations();
    </script>
</body>
</html>
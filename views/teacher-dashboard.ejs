<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý - Mobile Ready</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .exam-card { border: 1px solid #eee; border-radius: 10px; padding: 12px; margin-bottom: 10px; background: #fff; cursor: pointer; position: relative; }
        .active-exam { border: 2px solid #0d6efd; background: #f0f7ff; }
        .vlt-item { border-left: 4px solid #dc3545; background: #fff; margin-bottom: 8px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .delete-icon { position: absolute; top: 10px; right: 10px; color: #dc3545; }
    </style>
</head>
<body class="bg-light">
    <div class="container py-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold m-0">Giám sát: <%= user.user %></h5>
            <a href="/logout" class="btn btn-outline-danger btn-sm">Thoát</a>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold small mb-3">PHÁT HÀNH BÀI THI</h6>
                        <form action="/publish-exam" method="POST">
                            <input name="examName" class="form-control mb-2" placeholder="Tên bài thi" required>
                            <input name="examLink" class="form-control mb-2" placeholder="Link Google Form" required>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <div class="form-check form-switch small">
                                    <input class="form-check-input" type="checkbox" name="useAI" checked> <label>AI</label>
                                </div>
                                <div class="form-check form-switch small">
                                    <input class="form-check-input" type="checkbox" name="useAntiTab" checked> <label>Chặn Tab</label>
                                </div>
                            </div>
                            <button class="btn btn-primary w-100 fw-bold">PUBLISH</button>
                        </form>
                    </div>
                </div>

                <div id="exam-list">
                    <% exams.forEach(exam => { %>
                        <div class="exam-card shadow-sm" onclick="selectExam('<%= exam.name %>', this)">
                            <div class="fw-bold text-truncate" style="max-width: 80%;"><%= exam.name %></div>
                            <small class="text-muted" style="font-size: 10px;">ID: <%= exam.id %></small>
                            <i class="bi bi-trash3-fill delete-icon" onclick="deleteExam('<%= exam.id %>', event)"></i>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="col-md-8">
                <div class="d-flex justify-content-between align-items-center mb-2 mt-3 mt-md-0">
                    <h6 class="fw-bold m-0">Danh sách vi phạm</h6>
                    <small id="vlt-sync" class="text-muted small"></small>
                </div>
                <div id="vlt-list">
                    <p class="text-center text-muted py-5">Chọn một bài thi để xem vi phạm</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        let selectedExam = null;
        function selectExam(name, el) {
            document.querySelectorAll('.exam-card').forEach(c => c.classList.remove('active-exam'));
            el.classList.add('active-exam');
            selectedExam = name;
            loadVlts();
        }

        function loadVlts() {
            if(!selectedExam) return;
            fetch('/get-violations').then(r => r.json()).then(data => {
                const filtered = data.filter(v => v.exam === selectedExam);
                const list = document.getElementById('vlt-list');
                list.innerHTML = filtered.length ? filtered.reverse().map(v => `
                    <div class="vlt-item p-2 d-flex align-items-center shadow-sm">
                        <div class="flex-grow-1">
                            <div class="fw-bold" style="font-size: 0.9rem;">${v.user}</div>
                            <div class="text-danger small fw-bold">${v.reason}</div>
                            <small class="text-muted">${v.time}</small>
                        </div>
                        <div class="ms-2">
                            <a href="${v.imagePath}" target="_blank">
                                <img src="${v.imagePath}" width="60" height="60" class="rounded object-fit-cover border">
                            </a>
                        </div>
                    </div>
                `).join('') : '<p class="text-center text-muted py-4 small">Chưa ghi nhận vi phạm</p>';
                document.getElementById('vlt-sync').innerText = new Date().toLocaleTimeString();
            });
        }

        function deleteExam(id, e) {
            e.stopPropagation();
            if(!confirm("Xóa bài thi này?")) return;
            fetch('/delete-exam', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({examId: id}) })
            .then(() => location.reload());
        }

        setInterval(loadVlts, 5000);
    </script>
</body>
</html>
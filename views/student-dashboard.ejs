<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Phòng Thi - MediaPipe AI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_detection"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils"></script>
    <style>
        #myvideo { background: #000; border-radius: 8px; width: 100%; transform: scaleX(-1); }
        #countdown-ui { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%); font-size: 60px; color: red; font-weight: bold; display: none; z-index: 20; }
        #camera-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); color: white; display: flex; align-items: center; justify-content: center; z-index: 30; border-radius: 8px; }
        iframe { border: none; height: 85vh; width: 100%; background: #fff; }
    </style>
</head>
<body class="bg-light">
    <div class="container-fluid py-2">
        <div class="row g-2">
            <div class="col-md-9">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex align-items-center p-2">
                        <select id="exam-select" class="form-select form-select-sm w-auto" onchange="changeExam()">
                            <option value="">-- Chọn bài thi --</option>
                            <% exams.forEach(exam => { %>
                                <option value="<%= exam.link %>" data-name="<%= exam.name %>" data-settings='<%= JSON.stringify(exam.settings) %>'><%= exam.name %></option>
                            <% }) %>
                        </select>
                        <b id="exam-title" class="ms-3 text-primary"></b>
                    </div>
                    <iframe id="exam-frame" class="d-none"></iframe>
                    <div id="no-exam" class="text-center py-5"><h5>Vui lòng chọn bài thi và khởi động AI</h5></div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-danger">
                    <div class="card-header bg-danger text-white text-center py-1 small fw-bold">GIÁM SÁT AI</div>
                    <div class="card-body p-0 position-relative">
                        <div id="camera-overlay"><button class="btn btn-primary btn-sm shadow" onclick="startSystem()">BẮT ĐẦU THI</button></div>
                        <video id="myvideo" autoplay playsinline muted></video>
                        <div id="countdown-ui">4</div>
                        <div id="ai-status" class="bg-dark text-white text-center py-2 small fw-bold">Chờ...</div>
                    </div>
                </div>
                <div id="sec-info" class="mt-2 small text-muted p-2 bg-white rounded border"></div>
                <canvas id="canvas" class="d-none"></canvas>
            </div>
        </div>
    </div>
    <script>
        const video = document.getElementById("myvideo");
        const aiStatus = document.getElementById("ai-status");
        const countdownUI = document.getElementById("countdown-ui");
        const canvas = document.getElementById("canvas");
        const overlay = document.getElementById("camera-overlay");
        let faceDetection = null, currentExam = null, violationInterval = null;

        function startSystem() {
            overlay.innerHTML = "<p class='small'>Đang tải AI...</p>";
            faceDetection = new FaceDetection({ locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_detection/${file}` });
            faceDetection.setOptions({ model: 'short', minDetectionConfidence: 0.6 });
            faceDetection.onResults(onResults);
            const camera = new Camera(video, { onFrame: async () => { await faceDetection.send({image: video}); }, width: 640, height: 480 });
            camera.start().then(() => { overlay.style.display = "none"; if (currentExam?.settings.vm) checkVM(); });
        }

        function onResults(results) {
            if (!currentExam?.settings.ai) return;
            const count = results.detections.length;
            if (count === 1) {
                aiStatus.innerText = "✅ HỢP LỆ";
                aiStatus.className = "bg-success text-white text-center py-2 small fw-bold";
                resetCountdown();
            } else {
                aiStatus.innerText = count > 1 ? `⚠️ ${count} NGƯỜI` : "❌ KHÔNG THẤY MẶT";
                aiStatus.className = "bg-danger text-white text-center py-2 small fw-bold";
                startCountdown();
            }
        }

        function changeExam() {
            const select = document.getElementById('exam-select'), option = select.options[select.selectedIndex];
            if (!select.value) return;
            currentExam = { name: option.getAttribute('data-name'), link: select.value, settings: JSON.parse(option.getAttribute('data-settings')) };
            document.getElementById("exam-frame").src = currentExam.link;
            document.getElementById("exam-frame").classList.remove('d-none');
            document.getElementById("no-exam").classList.add('d-none');
            document.getElementById("exam-title").innerText = "Bài thi: " + currentExam.name;
            document.getElementById("sec-info").innerHTML = `<b>Bảo mật:</b><br>${currentExam.settings.ai ? '✅ AI Face<br>' : ''}${currentExam.settings.antiTab ? '✅ Anti-Tab<br>' : ''}${currentExam.settings.vm ? '✅ VM Check' : ''}`;
        }

        function startCountdown() {
            if (violationInterval) return;
            let sec = 4; countdownUI.style.display = "block";
            violationInterval = setInterval(() => {
                sec--; countdownUI.innerText = sec;
                if (sec <= 0) { resetCountdown(); sendViolation("Vi phạm Camera (4s)"); }
            }, 1000);
        }

        function resetCountdown() { clearInterval(violationInterval); violationInterval = null; countdownUI.style.display = "none"; countdownUI.innerText = "4"; }

        function sendViolation(reason) {
            canvas.width = video.videoWidth; canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);
            fetch('/report-violation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user: '<%= user.user %>', image: canvas.toDataURL('image/png'), reason, examName: currentExam ? currentExam.name : "N/A" })
            });
        }

        window.onblur = () => { if(currentExam?.settings.antiTab) sendViolation("Rời khỏi trình duyệt"); };
        document.addEventListener('visibilitychange', () => { if(document.hidden && currentExam?.settings.antiTab) sendViolation("Chuyển tab"); });
    </script>
</body>
</html>
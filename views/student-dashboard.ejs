<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Phòng Thi Bảo Mật</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_detection"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils"></script>
    <style>
        #myvideo { background: #000; border-radius: 8px; width: 100%; transform: scaleX(-1); }
        #countdown-ui { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%); font-size: 70px; color: red; font-weight: bold; display: none; z-index: 20; text-shadow: 2px 2px 8px black; }
        #camera-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); color: white; display: flex; align-items: center; justify-content: center; z-index: 30; border-radius: 8px; }
        iframe { border: none; height: 85vh; width: 100%; background: #fff; border-radius: 8px; }
    </style>
</head>
<body class="bg-light">
    <div class="container-fluid py-2">
        <div class="row g-2">
            <div class="col-md-9">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex align-items-center p-2">
                        <select id="exam-select" class="form-select form-select-sm w-auto" onchange="startExam()">
                            <option value="">-- Chọn bài thi --</option>
                            <% exams.forEach(exam => { %>
                                <option value="<%= exam.link %>" data-name="<%= exam.name %>" data-settings='<%= JSON.stringify(exam.settings) %>'><%= exam.name %></option>
                            <% }) %>
                        </select>
                        <b id="exam-title" class="ms-3 text-primary"></b>
                    </div>
                    <iframe id="exam-frame" class="d-none"></iframe>
                    <div id="no-exam" class="text-center py-5"><h5>Vui lòng chọn bài thi và mở Camera</h5></div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-danger position-relative mb-2">
                    <div id="camera-overlay"><button class="btn btn-primary btn-sm" onclick="initAI()">MỞ CAMERA GIÁM SÁT</button></div>
                    <video id="myvideo" autoplay playsinline muted></video>
                    <div id="countdown-ui">4</div>
                    <div id="ai-status" class="bg-dark text-white text-center py-2 small fw-bold">Camera: Tắt</div>
                </div>
                <div id="sec-info" class="small p-2 bg-white rounded border"></div>
                <canvas id="canvas" class="d-none"></canvas>
            </div>
        </div>
    </div>

    <script>
        const video = document.getElementById("myvideo");
        const aiStatus = document.getElementById("ai-status");
        const countdownUI = document.getElementById("countdown-ui");
        const canvas = document.getElementById("canvas");
        const overlay = document.getElementById("camera-overlay");
        let faceDetection = null, currentExam = null, timer = null;

        // --- PHÁT HIỆN MÁY ẢO QUA WEBGL ---
        function checkVirtualMachine() {
            try {
                const canvasVM = document.createElement('canvas');
                const gl = canvasVM.getContext('webgl') || canvasVM.getContext('experimental-webgl');
                if (!gl) return false;
                const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
                if (!debugInfo) return false;
                const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL).toLowerCase();
                
                const vmKeywords = ['virtualbox', 'vmware', 'software responder', 'swiftshader', 'google swiftshader', 'llvmpipe', 'virtual'];
                return vmKeywords.some(kw => renderer.includes(kw));
            } catch (e) { return false; }
        }

        function initAI() {
            overlay.innerHTML = "<small>Đang tải AI...</small>";
            faceDetection = new FaceDetection({ locateFile: (f) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_detection/${f}` });
            faceDetection.setOptions({ model: 'short', minDetectionConfidence: 0.6 });
            faceDetection.onResults(onResults);
            new Camera(video, { onFrame: async () => { await faceDetection.send({image: video}); }, width: 640, height: 480 }).start();
            overlay.style.display = "none";
        }

        function onResults(res) {
            if (!currentExam?.settings.ai) return;
            const count = res.detections.length;
            if (count === 1) {
                aiStatus.innerText = "✅ HỢP LỆ";
                aiStatus.className = "bg-success text-white text-center py-2 small fw-bold";
                resetTimer();
            } else {
                aiStatus.innerText = count > 1 ? "⚠️ NHIỀU NGƯỜI" : "❌ KHÔNG THẤY MẶT";
                aiStatus.className = "bg-danger text-white text-center py-2 small fw-bold";
                startTimer();
            }
        }

        function startExam() {
            const sel = document.getElementById('exam-select'), opt = sel.options[sel.selectedIndex];
            if (!sel.value) return;
            
            currentExam = { 
                name: opt.getAttribute('data-name'), 
                link: sel.value, 
                settings: JSON.parse(opt.getAttribute('data-settings')) 
            };

            // Kiểm tra máy ảo nếu có cài đặt
            if(currentExam.settings.antiVM && checkVirtualMachine()) {
                alert("CẢNH BÁO: Hệ thống phát hiện bạn đang sử dụng MÁY ẢO. Hành vi này đã bị ghi lại!");
                report("Sử dụng Máy ảo (Virtual Machine)");
            }

            document.getElementById("exam-frame").src = currentExam.link;
            document.getElementById("exam-frame").classList.remove('d-none');
            document.getElementById("no-exam").classList.add('d-none');
            document.getElementById("exam-title").innerText = "Đang thi: " + currentExam.name;
            document.getElementById("sec-info").innerHTML = `
                <b>Chế độ bảo mật:</b><br>
                ${currentExam.settings.ai ? '✅ Giám sát AI<br>' : ''}
                ${currentExam.settings.antiTab ? '✅ Chống chuyển Tab<br>' : ''}
                ${currentExam.settings.antiVM ? '✅ Chặn máy ảo' : ''}
            `;
        }

        function startTimer() {
            if (timer) return;
            let s = 4; countdownUI.style.display = "block";
            timer = setInterval(() => {
                s--; countdownUI.innerText = s;
                if (s <= 0) { resetTimer(); report("Vi phạm Camera (vắng mặt 4s)"); }
            }, 1000);
        }

        function resetTimer() { clearInterval(timer); timer = null; countdownUI.style.display = "none"; countdownUI.innerText = "4"; }

        function report(reason) {
            canvas.width = video.videoWidth; canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);
            fetch('/report-violation', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ 
                    user: '<%= user.user %>', 
                    image: canvas.toDataURL('image/png'), 
                    reason, 
                    examName: currentExam?.name || "N/A" 
                })
            });
        }

        // Chống chuyển Tab
        window.onblur = () => { if(currentExam?.settings.antiTab) report("Rời tab trình duyệt"); };
        document.addEventListener('visibilitychange', () => { 
            if(document.hidden && currentExam?.settings.antiTab) report("Chuyển sang ứng dụng khác"); 
        });
    </script>
</body>
</html>
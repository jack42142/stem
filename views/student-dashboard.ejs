<!DOCTYPE html>
<html lang="vi">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Học sinh - Thi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/handtrackjs/dist/handtrack.min.js"></script>
    <style>
        body { background-color: #f4f7f6; }
        .video-box { position: relative; background: #000; border-radius: 12px; width: 100%; aspect-ratio: 4/3; overflow: hidden; border: 4px solid #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        #myvideo { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
        #camera-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; color: #333; display: flex; align-items: center; justify-content: center; z-index: 100; text-align: center; padding: 20px; }
        .camera-active #camera-overlay { display: none !important; }
        #ai-status { position: absolute; bottom: 0; width: 100%; background: rgba(255,255,255,0.9); color: #333; text-align: center; padding: 8px; font-weight: bold; border-top: 1px solid #dee2e6; }
        iframe { border-radius: 12px; background: #fff; }
    </style>
</head>
<body class="py-3">
    <div class="container-fluid">
        <div class="row g-3">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm p-3 mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <h6 class="mb-0 fw-bold">Chọn bài thi:</h6>
                        <select id="exam-select" class="form-select w-auto" onchange="changeExam()">
                            <option value="">-- Danh sách bài thi --</option>
                            <% exams.forEach(exam => { %>
                                <option value="<%= exam.id %>" data-link="<%= exam.link %>" data-policy='<%= JSON.stringify(exam.policy) %>'><%= exam.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <iframe id="frame" src="" width="100%" height="75vh" class="d-none border-0 shadow-sm"></iframe>
            </div>

            <div class="col-md-4">
                <div class="video-box" id="cam-container">
                    <div id="camera-overlay">
                        <div>
                            <p class="mb-3 text-muted">Nhấn nút bên dưới để bắt đầu giám sát</p>
                            <button class="btn btn-primary fw-bold px-4" onclick="initCam()">KÍCH HOẠT CAMERA</button>
                        </div>
                    </div>
                    <video id="myvideo" autoplay playsinline muted></video>
                    <canvas id="canvas" class="d-none"></canvas>
                    <div id="ai-status">TRẠNG THÁI: CHỜ...</div>
                </div>
                <div class="card mt-3 border-0 shadow-sm p-3 bg-white">
                    <h6 class="fw-bold mb-2">Quy định phòng thi:</h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li>Không rời khỏi vị trí khi đang làm bài.</li>
                        <li>Không mở tab/cửa sổ khác.</li>
                        <li>AI sẽ tự động báo cáo nếu phát hiện vi phạm.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        const video = document.getElementById("myvideo");
        const camContainer = document.getElementById("cam-container");
        let model, currentExamId, currentPolicy = {}, isViolating = false;

        async function initCam() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = stream;
                video.onloadedmetadata = () => {
                    video.play();
                    camContainer.classList.add("camera-active");
                    loadAI();
                };
            } catch (e) { alert("Không thể mở Camera. Hãy cấp quyền hoặc dùng localhost/https."); }
        }

        async function loadAI() {
            document.getElementById("ai-status").innerText = "ĐANG TẢI AI...";
            model = await handtrack.load({ scoreThreshold: 0.6 });
            document.getElementById("ai-status").innerText = "SẴN SÀNG GIÁM SÁT ✅";
            detect();
        }

        function changeExam() {
            const sel = document.getElementById('exam-select');
            const opt = sel.options[sel.selectedIndex];
            if (!sel.value) return;
            currentExamId = sel.value;
            currentPolicy = JSON.parse(opt.getAttribute('data-policy'));
            document.getElementById("frame").src = opt.getAttribute('data-link');
            document.getElementById("frame").classList.remove('d-none');
        }

        function detect() {
            if (!currentPolicy.enableAI) return;
            model.detect(video).then(preds => {
                const count = preds.filter(p => p.label !== 'point').length;
                const statusEl = document.getElementById("ai-status");
                if (count === 1) {
                    statusEl.innerText = "HỢP LỆ ✅"; statusEl.style.color = "#28a745";
                    isViolating = false;
                } else {
                    const r = count > 1 ? `⚠️ PHÁT HIỆN ${count} NGƯỜI` : "❌ VẮNG MẶT";
                    statusEl.innerText = r; statusEl.style.color = "#dc3545";
                    if (currentExamId && !isViolating) { isViolating = true; sendV(r); }
                }
                requestAnimationFrame(detect);
            });
        }

        function sendV(reason) {
            const canvas = document.getElementById("canvas");
            canvas.width = video.videoWidth; canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);
            fetch('/report-violation', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user: '<%= user.user %>', image: canvas.toDataURL('image/png'), reason, examId: currentExamId })
            });
        }

        window.onblur = () => { if(currentExamId && currentPolicy.antiTab) { sendV("Rời tab thi"); }};
    </script>
</body>
</html>